# Public site URL used for canonicals, Open Graph, sitemap, and robots.
# Production (owner-provided):
NEXT_PUBLIC_SITE_URL=https://automotonews.in
# Local development override:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WordPress REST API base (server-only — do not prefix with NEXT_PUBLIC_)
# After cms content sync: always use cms (required before apex DNS → Vercel).
WP_API_URL=https://cms.automotonews.in/wp-json/wp/v2
# Optional explicit host for /wp-* rewrites (defaults from WP_API_URL):
# WORDPRESS_ORIGIN=https://cms.automotonews.in

# Analytics (Phase 9 — required before claiming launch readiness)
# Create a GA4 property, then set the measurement ID (format: G-XXXXXXXXXX).
# NEXT_PUBLIC_GA_ID=

# AdSense (optional until you have an approved publisher account)
# Leave client/slot IDs unset or commented: ad panels and slots remain in the UI
# with reserved min-height placeholders (“Ad space reserved”) — no live ads load.
# Do not invent publisher or unit IDs. Set real values only after AdSense approval.
#
# Client ID format: ca-pub-xxxxxxxx
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=
#
# Optional unit slot IDs from AdSense:
# NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
# NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
# NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
# NEXT_PUBLIC_ADSENSE_SLOT_MOBILE_ANCHOR=
#
# Enable Google Auto ads only after reviewing AdSense Auto ads settings:
# NEXT_PUBLIC_ADSENSE_AUTO_ADS=false

# Newsletter (Phase 9 — not wired yet)
# Choose a provider (Brevo, Mailchimp, etc.) and add server-only credentials.
# Do not invent keys. Until configured, the homepage form reports “not configured”.
# NEWSLETTER_PROVIDER=
# NEWSLETTER_API_KEY=
# NEWSLETTER_LIST_ID=
