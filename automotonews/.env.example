# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WordPress REST API base (server-only — do not prefix with NEXT_PUBLIC_)
# Example for AutomotoNews.in public REST API:
WP_API_URL=https://automotonews.in/wp-json/wp/v2

# Analytics / ads (later phases — leave empty until real IDs exist)
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=
